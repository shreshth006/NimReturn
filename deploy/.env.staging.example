# DNS A/AAAA record pointing at the staging host. Enter only the hostname.
PUBLIC_HOST=staging.example.com

# Dedicated LOGIN role that is only a member of nimreturn_runtime.
DATABASE_URL=postgresql://nimreturn_app:replace-me@postgres.example.com:5432/nimreturn

# Migration owner with CREATE ROLE permission. Used only by the one-shot migrate profile.
MIGRATION_DATABASE_URL=postgresql://nimreturn_owner:replace-me@postgres.example.com:5432/nimreturn

# Server-only TestAlbatross JSON-RPC endpoint. Never prefix this variable with VITE_.
NIMIQ_RPC_URL=https://rpc.example.com

# Generate at least 32 unpredictable characters; do not reuse a wallet secret.
SESSION_SECRET=replace-with-a-random-server-secret
