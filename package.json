{
  "name": "nimreturn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The consumer-protection layer for Nimiq Pay.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "node dist-server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:db": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/run-migrations.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@nimiq/core": "2.21.0",
    "@nimiq/mini-app-sdk": "0.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
