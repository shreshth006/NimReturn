# Browser origin for the local API. Leave empty when the API is reverse-proxied.
VITE_API_BASE_URL=http://localhost:3001

# Server-only Nimiq JSON-RPC endpoint. Never expose credentials through VITE_*.
NIMIQ_RPC_URL=

# Fail closed unless the configured node reports this network.
NIMIQ_NETWORK=TestAlbatross

PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nimreturn
