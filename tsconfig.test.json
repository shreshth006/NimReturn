{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "tests/**/*.ts",
    "server/app.ts",
    "server/config.ts",
    "server/http/**/*.ts",
    "src/features/diagnostics/**/*.ts",
    "src/lib/api/**/*.ts",
    "src/lib/crypto/**/*.ts",
    "src/lib/nimiq/**/*.ts",
    "src/lib/protocol/**/*.ts",
    "server/db/**/*.ts",
    "server/domain/**/*.ts",
    "server/rpc/**/*.ts"
  ]
}
